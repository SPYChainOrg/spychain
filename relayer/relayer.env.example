# Copy to relayer.env and fill in. NEVER commit relayer.env (it holds the wallet-decrypt key).
L2_RPC=http://localhost:8449
# BSC RPC must support eth_getLogs (the SDK looks up the confirming assertion). A keyed provider.
BSC_RPC=https://YOUR-BSC-RPC
POLL_INTERVAL_MS=45000
START_BLOCK=0
# From gen-wallet.mjs — decrypts .relayer.json at startup:
RELAYER_ENC_KEY=
# Alternatively, skip the encrypted file and set the key directly (less safe):
# RELAYER_PRIVATE_KEY=0x...
